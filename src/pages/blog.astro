---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { gitMeta, resolveAuthor, ogImage, fmtDate, SITE } from '../utils/articles.js';

const articles = (await getCollection('docs'))
	.filter((entry) => entry.id.startsWith('articles/'))
	.map((entry) => {
		const meta = gitMeta(entry.filePath ?? '');
		return {
			href: `/${entry.id}`,
			title: entry.data.title,
			description: entry.data.description,
			image: ogImage(entry),
			author: resolveAuthor(entry, meta.gitAuthor),
			created: meta.created,
			updated: meta.updated,
		};
	})
	.sort((a, b) => b.created.getTime() - a.created.getTime());

// How many cards are visible before the reader scrolls (progressive reveal).
const INITIAL_BATCH = 12;

const pageTitle = 'Blog';
const pageDescription =
	'Benchmarks, engineering deep-dives, and updates from the TidesDB team.';
const canonical = `${SITE}/blog`;
const socialImage = articles.find((a) => a.image)?.image ?? `${SITE}/tidesdb-logo-v8.svg`;

// Blog + ItemList structured data so search engines understand the listing.
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Blog',
	name: 'TidesDB Blog',
	description: pageDescription,
	url: canonical,
	publisher: {
		'@type': 'Organization',
		name: 'TidesDB',
		url: SITE,
		logo: { '@type': 'ImageObject', url: `${SITE}/tidesdb-logo-v8.svg` },
	},
	blogPost: articles.map((a) => ({
		'@type': 'BlogPosting',
		headline: a.title,
		description: a.description,
		url: `${SITE}${a.href}`,
		datePublished: a.created.toISOString(),
		dateModified: a.updated.toISOString(),
		...(a.image ? { image: a.image } : {}),
		author: {
			'@type': 'Person',
			name: a.author.name,
			...(a.author.url ? { url: a.author.url } : {}),
		},
	})),
};

const head = [
	{ tag: 'link', attrs: { rel: 'canonical', href: canonical } },
	{ tag: 'meta', attrs: { property: 'og:type', content: 'website' } },
	{ tag: 'meta', attrs: { property: 'og:url', content: canonical } },
	{ tag: 'meta', attrs: { property: 'og:title', content: `${pageTitle} · TidesDB` } },
	{ tag: 'meta', attrs: { property: 'og:description', content: pageDescription } },
	{ tag: 'meta', attrs: { property: 'og:image', content: socialImage } },
	{ tag: 'meta', attrs: { name: 'twitter:card', content: 'summary_large_image' } },
	{ tag: 'meta', attrs: { name: 'twitter:title', content: `${pageTitle} · TidesDB` } },
	{ tag: 'meta', attrs: { name: 'twitter:description', content: pageDescription } },
	{ tag: 'meta', attrs: { name: 'twitter:image', content: socialImage } },
	{
		tag: 'script',
		attrs: { type: 'application/ld+json' },
		content: JSON.stringify(jsonLd),
	},
] as any[];
---

<StarlightPage
	frontmatter={{
		title: pageTitle,
		description: pageDescription,
		tableOfContents: false,
		pagefind: false,
		head,
	}}
>
	<p class="blog-intro">{pageDescription}</p>

	<ul class="blog-grid" data-blog-grid data-initial={INITIAL_BATCH}>
		{
			articles.map((a) => (
				<li class="blog-item">
					<a class="blog-card" href={a.href}>
						{a.image && (
							<div class="blog-card-media">
								<img src={a.image} alt={a.title} loading="lazy" />
							</div>
						)}
						<div class="blog-card-body">
							<div class="blog-card-meta">
								<time datetime={a.created.toISOString()}>{fmtDate(a.created)}</time>
								{a.author.name && <span class="blog-card-author">by {a.author.name}</span>}
							</div>
							<h2>{a.title}</h2>
							<p>{a.description}</p>
						</div>
					</a>
				</li>
			))
		}
	</ul>

	<div data-blog-sentinel aria-hidden="true"></div>
	<p data-blog-status class="blog-status" role="status" aria-live="polite"></p>
</StarlightPage>

<script>
	// Progressive reveal ("infinite scroll"). All cards are already in the HTML
	// for SEO/no-JS; JS just hides the overflow and reveals a batch at a time as
	// the sentinel scrolls into view.
	const grid = document.querySelector('[data-blog-grid]');
	const sentinel = document.querySelector('[data-blog-sentinel]');
	const status = document.querySelector('[data-blog-status]');

	if (grid && sentinel) {
		const items = Array.from(grid.querySelectorAll<HTMLElement>('.blog-item'));
		const batch = Number(grid.getAttribute('data-initial')) || 12;
		let shown = 0;

		const render = () => {
			shown = Math.min(shown + batch, items.length);
			items.forEach((el, i) => {
				el.hidden = i >= shown;
			});
			if (status) {
				status.textContent =
					shown >= items.length ? `All ${items.length} posts shown` : '';
			}
		};

		render(); // initial batch

		const observer = new IntersectionObserver(
			(entries) => {
				if (entries.some((e) => e.isIntersecting) && shown < items.length) {
					render();
				}
			},
			{ rootMargin: '400px 0px' }
		);
		observer.observe(sentinel);
	}
</script>

<style>
	.blog-intro {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-lg);
		margin-bottom: 2rem;
	}

	.blog-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 1.5rem;
	}

	.blog-item {
		margin: 0;
		padding: 0;
	}

	.blog-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		border: 1px solid var(--sl-color-gray-6);
		border-radius: 12px;
		overflow: hidden;
		background: var(--sl-color-bg-sidebar);
		color: inherit;
		text-decoration: none;
		transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
	}

	.blog-card:hover {
		border-color: var(--sl-color-accent);
		transform: translateY(-3px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
	}

	.blog-card-media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--sl-color-gray-6);
	}

	.blog-card-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.blog-card-body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.15rem 1.25rem 1.35rem;
	}

	.blog-card-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem;
		font-size: 0.8rem;
	}

	.blog-card-meta time {
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--sl-color-accent-high);
	}

	.blog-card-author {
		color: var(--sl-color-gray-4);
	}

	.blog-card-body h2 {
		font-size: 1.05rem;
		line-height: 1.35;
		font-weight: 600;
		margin: 0;
		color: var(--sl-color-white);
	}

	.blog-card-body p {
		font-size: 0.9rem;
		line-height: 1.5;
		margin: 0;
		color: var(--sl-color-gray-3);
	}

	.blog-status {
		text-align: center;
		color: var(--sl-color-gray-4);
		font-size: 0.85rem;
		margin-top: 2rem;
		min-height: 1.2em;
	}
</style>
