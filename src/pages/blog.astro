---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Icon } from '@astrojs/starlight/components';
import { articleDates, resolveAuthor, ogImage, fmtDateShort, summarize, SITE, publishedArticles } from '../utils/articles.js';
import { readingMinutes } from '../utils/reading-time.js';

const articles = publishedArticles(await getCollection('docs'))
	.map((entry) => {
		const meta = articleDates(entry);
		return {
			href: `/${entry.id}`,
			title: entry.data.title,
			description: summarize(entry),
			image: ogImage(entry),
			author: resolveAuthor(entry, meta.gitAuthor),
			minutes: readingMinutes(entry.body ?? ''),
			created: meta.created,
			updated: meta.updated,
		};
	})
	.sort((a, b) => b.created.getTime() - a.created.getTime());

// How many cards are visible before the reader scrolls (progressive reveal).
const INITIAL_BATCH = 12;

const pageTitle = 'Blog';
const pageDescription =
	'Benchmarks, engineering deep-dives, and updates from the TidesDB team.';
const canonical = `${SITE}/blog`;
const socialImage = articles.find((a) => a.image)?.image ?? `${SITE}/tidesdb-logo-v8.svg`;

// Blog + ItemList structured data so search engines understand the listing.
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Blog',
	name: 'TidesDB Blog',
	description: pageDescription,
	url: canonical,
	publisher: {
		'@type': 'Organization',
		name: 'TidesDB',
		url: SITE,
		logo: { '@type': 'ImageObject', url: `${SITE}/tidesdb-logo-v8.svg` },
	},
	blogPost: articles.map((a) => ({
		'@type': 'BlogPosting',
		headline: a.title,
		description: a.description,
		url: `${SITE}${a.href}`,
		datePublished: a.created.toISOString(),
		dateModified: a.updated.toISOString(),
		...(a.image ? { image: a.image } : {}),
		author: {
			'@type': 'Person',
			name: a.author.name,
			...(a.author.url ? { url: a.author.url } : {}),
		},
	})),
};

const head = [
	{ tag: 'link', attrs: { rel: 'canonical', href: canonical } },
	{ tag: 'meta', attrs: { property: 'og:type', content: 'website' } },
	{ tag: 'meta', attrs: { property: 'og:url', content: canonical } },
	{ tag: 'meta', attrs: { property: 'og:title', content: `${pageTitle} · TidesDB` } },
	{ tag: 'meta', attrs: { property: 'og:description', content: pageDescription } },
	{ tag: 'meta', attrs: { property: 'og:image', content: socialImage } },
	{ tag: 'meta', attrs: { name: 'twitter:card', content: 'summary_large_image' } },
	{ tag: 'meta', attrs: { name: 'twitter:title', content: `${pageTitle} · TidesDB` } },
	{ tag: 'meta', attrs: { name: 'twitter:description', content: pageDescription } },
	{ tag: 'meta', attrs: { name: 'twitter:image', content: socialImage } },
	{
		tag: 'script',
		attrs: { type: 'application/ld+json' },
		content: JSON.stringify(jsonLd),
	},
] as any[];
---

<StarlightPage
	frontmatter={{
		title: pageTitle,
		description: pageDescription,
		tableOfContents: false,
		pagefind: false,
		head,
	}}
>
	<div class="blog-head not-content">
		<p class="blog-intro">{pageDescription}</p>
		<a class="blog-feed" href="/rss.xml" title="Subscribe to the RSS feed">
			<Icon name="rss" />
			<span>RSS feed</span>
		</a>
	</div>

	<ul class="blog-grid not-content" data-blog-grid data-initial={INITIAL_BATCH}>
		{
			articles.map((a) => (
				<li class="blog-item">
					<a class="blog-card" href={a.href}>
						<div class="blog-card-media">
							{a.image && <img src={a.image} alt={a.title} loading="lazy" />}
						</div>
						<div class="blog-card-body">
							<div class="blog-card-meta">
								<time datetime={a.created.toISOString()}>{fmtDateShort(a.created)}</time>
								{a.author.name && <span class="blog-card-author">by {a.author.name}</span>}
								<span class="blog-card-time">{a.minutes} min read</span>
							</div>
							<h2>{a.title}</h2>
							<p>{a.description}</p>
						</div>
					</a>
				</li>
			))
		}
	</ul>

	<div data-blog-sentinel aria-hidden="true"></div>
	<p data-blog-status class="blog-status" role="status" aria-live="polite"></p>
</StarlightPage>

<script>
	// Progressive reveal ("infinite scroll"). All cards are already in the HTML
	// for SEO/no-JS; JS just hides the overflow and reveals a batch at a time as
	// the sentinel scrolls into view.
	const grid = document.querySelector('[data-blog-grid]');
	const sentinel = document.querySelector('[data-blog-sentinel]');
	const status = document.querySelector('[data-blog-status]');

	if (grid && sentinel) {
		const items = Array.from(grid.querySelectorAll<HTMLElement>('.blog-item'));
		const batch = Number(grid.getAttribute('data-initial')) || 12;
		let shown = 0;

		const render = () => {
			shown = Math.min(shown + batch, items.length);
			items.forEach((el, i) => {
				el.hidden = i >= shown;
			});
			if (status) {
				status.textContent =
					shown >= items.length ? `All ${items.length} posts shown` : '';
			}
		};

		render(); // initial batch

		const observer = new IntersectionObserver(
			(entries) => {
				if (entries.some((e) => e.isIntersecting) && shown < items.length) {
					render();
				}
			},
			{ rootMargin: '400px 0px' }
		);
		observer.observe(sentinel);
	}
</script>

<style>
	/* The intro and the feed button share a row, with the button pushed to the
	   trailing edge. `not-content` keeps Starlight's prose margins off the row,
	   which would otherwise space the two children apart vertically. */
	.blog-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		margin-bottom: 2rem;
	}

	.blog-intro {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-lg);
		margin: 0;
		flex: 1 1 18rem;
	}

	.blog-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.5rem;
	}

	/* `not-content` on the grid is Starlight's opt-out from its prose styles, and
	   this markup needs it. `.sl-markdown-content li + li` sets margin-top 0.25rem,
	   which gave every card except the first a 4px offset inside its grid row, and
	   its `:not(...) + :not(...)` rule adds 1rem between the title and description
	   on top of the body's own gap. Both outrank a scoped `.blog-item` reset, so
	   opting the subtree out is the fix rather than fighting specificity. */
	.blog-item {
		margin: 0;
		padding: 0;
	}

	.blog-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		border: 1px solid var(--sl-color-gray-6);
		border-radius: 12px;
		overflow: hidden;
		background: var(--sl-color-bg-sidebar);
		color: inherit;
		text-decoration: none;
		transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
	}

	.blog-card:hover {
		border-color: var(--sl-color-accent);
		transform: translateY(-3px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
	}

	.blog-card-media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		flex-shrink: 0;
		/* Also the placeholder for the articles that ship no og:image. */
		background: linear-gradient(
			135deg,
			var(--sl-color-gray-6) 0%,
			var(--sl-color-bg-sidebar) 100%
		);
	}

	.blog-card-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.blog-card-body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.15rem 1.25rem 1.35rem;
		flex: 1;
	}

	/* Three items in roughly 250px, so it is set small and tight. Separated by
	   middots rather than whitespace alone, which keeps the parts legible as one
	   line and reads correctly if it does wrap. */
	.blog-card-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.3rem;
		font-size: 0.72rem;
		line-height: 1.4;
	}

	.blog-card-author::before,
	.blog-card-time::before {
		content: '\00b7';
		margin-inline-end: 0.3rem;
		color: var(--sl-color-gray-5);
	}

	/* Same shape as the Print button on article pages, so the site has one
	   button style rather than two. */
	.blog-feed {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		flex-shrink: 0;
		margin-inline-start: auto;
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 6px;
		background: transparent;
		color: var(--sl-color-gray-3) !important;
		font-size: 0.8rem;
		text-decoration: none !important;
		border-bottom: 1px solid var(--sl-color-gray-5) !important;
		white-space: nowrap;
		transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
	}

	.blog-feed:hover,
	.blog-feed:focus-visible {
		color: var(--sl-color-white) !important;
		border-color: var(--sl-color-accent) !important;
		background: var(--sl-color-accent-low);
		outline: none;
	}

	.blog-feed svg {
		flex-shrink: 0;
		width: 15px;
		height: 15px;
	}

	@media (prefers-reduced-motion: reduce) {
		.blog-feed {
			transition: none;
		}
	}

	/* No `margin-inline-start: auto` here. It pinned this to the right edge, so
	   once the row wrapped the reading time sat alone on a second line far from
	   the date and author it belongs with. */
	.blog-card-time {
		white-space: nowrap;
		opacity: 0.85;
	}

	.blog-card-meta time {
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--sl-color-accent-high);
	}

	.blog-card-author {
		color: var(--sl-color-gray-4);
	}

	/* Two lines always, so a one-line title does not pull its description up a
	   line above the card beside it. Longer titles clamp with an ellipsis. */
	.blog-card-body h2 {
		font-size: 1.05rem;
		line-height: 1.35;
		font-weight: 600;
		margin: 0;
		color: var(--sl-color-white);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		min-height: calc(2 * 1.35 * 1.05rem);
	}

	/* Fixed three lines, like the two-line title above it. Clamping alone only
	   caps the height, it does not set one, so a short description still made its
	   card shorter than the card beside it and the row then bottom-aligned them. */
	.blog-card-body p {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		min-height: calc(3 * 1.5 * 0.9rem);
		font-size: 0.9rem;
		line-height: 1.5;
		margin: 0;
		color: var(--sl-color-gray-3);
	}

	.blog-status {
		text-align: center;
		color: var(--sl-color-gray-4);
		font-size: 0.85rem;
		margin-top: 2rem;
		min-height: 1.2em;
	}
</style>
