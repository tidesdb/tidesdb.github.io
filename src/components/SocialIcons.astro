---
// Top-nav additions: a "Docs" dropdown (the docs entry point from anywhere on
// the site), a "Blog" link, and a "Company" dropdown for the footer/company
// pages. Then Starlight's default social icons. Lives in the header everywhere.
//
// NOTE: Starlight wraps this in `.sl-hidden md:sl-flex`, so everything here is
// invisible below 50rem. The same links are rendered for mobile by
// MobileSiteNav.astro, from the shared list in config/site-nav.js.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import NavDropdown from './NavDropdown.astro';
import { siteNavSections } from '../config/site-nav.js';

const sections = siteNavSections();
---

{
	sections.map((section) =>
		section.links ? (
			<NavDropdown label={section.label} id={section.id} links={section.links} />
		) : (
			<a href={section.href} class="header-nav-link">
				{section.label}
			</a>
		)
	)
}
<Default><slot /></Default>

<style>
	.header-nav-link {
		font-size: var(--sl-text-sm);
		font-weight: 500;
		white-space: nowrap;
		border-bottom: none;
		align-self: center;
		padding-inline: 0.25rem;
	}
</style>

<script>
	const dropdowns = Array.from(document.querySelectorAll<HTMLElement>('.nav-dd'));
	const closeAll = (except?: HTMLElement) => {
		for (const dd of dropdowns) {
			if (dd === except) continue;
			dd.classList.remove('is-open');
			dd.querySelector('.nav-dd__btn')?.setAttribute('aria-expanded', 'false');
		}
	};
	for (const dd of dropdowns) {
		const btn = dd.querySelector('.nav-dd__btn');
		btn?.addEventListener('click', (e) => {
			e.stopPropagation();
			const open = dd.classList.toggle('is-open');
			btn.setAttribute('aria-expanded', String(open));
			if (open) closeAll(dd);
		});
	}
	document.addEventListener('click', (e) => {
		const t = e.target as Node;
		if (!dropdowns.some((dd) => dd.contains(t))) closeAll();
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeAll();
	});
</script>
