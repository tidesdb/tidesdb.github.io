keybench 0.1.1 replay file - reproduce with:  keybench --config /root/keybench/results-blobdb/rocksdbblob-valsize/20260903-120545/replay.cnf

[bench]
backend = rocksdb
threads = 1,2,4,8,16
seed_threads = 8
pin = 1
secs = 60
users  = 100000
items  = 40960
seed   = 1
repeat = 3
data_dir = /data/bench
report_dir = /root/keybench/results-blobdb/rocksdbblob-valsize
workload = workloads/valsize.lua

[rocksdb]
compression = kNoCompression
enable_blob_files = true
min_blob_size = 1024
enable_blob_garbage_collection = true
