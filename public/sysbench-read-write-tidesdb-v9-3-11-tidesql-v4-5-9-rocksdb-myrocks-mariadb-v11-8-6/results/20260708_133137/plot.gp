set datafile separator ','
set terminal pngcairo size 1100,600 font ',11'
set grid lc rgb '#dddddd'; set border lc rgb '#666666'
set key top right; set xlabel 'time (s)'
set output 'results/20260708_133137/tps_over_time.png'
set title 'sysbench oltp\_read\_write - transactions/sec (higher is better)'
set ylabel 'transactions/sec'
plot '< grep "^rocksdb," results/20260708_133137/intervals.csv' using 2:4 with linespoints lw 2 pt 7 ps 0.7 lc rgb '#F3B802' title 'rocksdb', '< grep "^tidesdb," results/20260708_133137/intervals.csv' using 2:4 with linespoints lw 2 pt 7 ps 0.7 lc rgb '#173ACC' title 'tidesdb'
set output 'results/20260708_133137/qps_over_time.png'
set title 'sysbench oltp\_read\_write - queries/sec (higher is better)'
set ylabel 'queries/sec'
plot '< grep "^rocksdb," results/20260708_133137/intervals.csv' using 2:5 with linespoints lw 2 pt 7 ps 0.7 lc rgb '#F3B802' title 'rocksdb', '< grep "^tidesdb," results/20260708_133137/intervals.csv' using 2:5 with linespoints lw 2 pt 7 ps 0.7 lc rgb '#173ACC' title 'tidesdb'
set output 'results/20260708_133137/lat95_over_time.png'
set title 'sysbench oltp\_read\_write - p95 latency (lower is better)'
set ylabel 'p95 latency (ms)'
plot '< grep "^rocksdb," results/20260708_133137/intervals.csv' using 2:9 with linespoints lw 2 pt 7 ps 0.7 lc rgb '#F3B802' title 'rocksdb', '< grep "^tidesdb," results/20260708_133137/intervals.csv' using 2:9 with linespoints lw 2 pt 7 ps 0.7 lc rgb '#173ACC' title 'tidesdb'
